# ─────────────────────────────────────────────────────────────
# 나무파트너스 단체보험 플랫폼 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# [필수/운영] 개인정보 암호화·세션 서명에 사용하는 마스터 시크릿.
# 운영 배포 시 반드시 32자 이상의 임의 문자열로 교체할 것.
# 이 값이 바뀌면 기존에 저장된 개인정보는 복호화할 수 없습니다.
NP_SECRET=

# [필수/운영] 관리자 페이지(/admin) 로그인 비밀번호.
# 미설정 시 개발용 기본값(namu-admin)이 사용되며, 운영에서는 반드시 설정할 것.
ADMIN_PASSWORD=

# [선택] 로컬 JSON 데이터 스토어 경로 (기본: <프로젝트>/.data)
# NP_DATA_DIR=.data

# ─────────────────────────────────────────────────────────────
# 알림 발송 (기획서 6장) — 미설정 시 콘솔 로그로만 기록됩니다.
# ─────────────────────────────────────────────────────────────
# console | kakao | sms
NOTIFY_PROVIDER=console

# 카카오 알림톡 (예: NHN Cloud / 카카오 비즈메시지 대행사)
KAKAO_ALIMTALK_API_URL=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_TEMPLATE_QUEUE_READY=

# SMS 폴백
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NUMBER=
