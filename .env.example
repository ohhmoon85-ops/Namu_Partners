# ─────────────────────────────────────────────────────────────
# 나무파트너스 단체보험 플랫폼 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# [필수/운영] 개인정보 암호화·세션 서명에 사용하는 마스터 시크릿.
# 운영 배포 시 반드시 32자 이상의 임의 문자열로 교체할 것.
# 이 값이 바뀌면 기존에 저장된 개인정보는 복호화할 수 없습니다.
NP_SECRET=

# [필수/운영] 관리자 페이지(/admin) 로그인 비밀번호.
# 미설정 시 개발용 기본값(namu-admin)이 사용되며, 운영에서는 반드시 설정할 것.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 데이터베이스 (Supabase / Postgres)
#
# 설정하면 Supabase 의 namu 스키마를 사용하고,
# 비워 두면 로컬 JSON 파일(.data/store.json)로 동작합니다.
#
# ⚠️ 서버리스(Vercel) 배포 시에는 반드시 설정해야 합니다.
#    미설정 시 인스턴스마다 데이터가 갈라집니다.
#
# Supabase 대시보드 → Connect → "Transaction pooler" 문자열을 사용하세요.
# 세션 풀러(5432)가 아니라 트랜잭션 풀러(6543)여야 합니다.
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 비밀번호에 특수문자가 있으면 URL 인코딩할 것 (예: @ → %40)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=

# [선택] 인스턴스당 최대 커넥션 (기본 3). 서버리스에서는 작게 유지할 것.
# PGPOOL_MAX=3

# [선택] TLS 인증서 검증 강제 (기본 false — 풀러 인증서 체인 이슈 회피)
# PGSSL_REJECT_UNAUTHORIZED=true

# [선택] 로컬 JSON 데이터 스토어 경로 (기본: <프로젝트>/.data)
# NP_DATA_DIR=.data

# ─────────────────────────────────────────────────────────────
# 알림 발송 (기획서 6장) — 미설정 시 콘솔 로그로만 기록됩니다.
# ─────────────────────────────────────────────────────────────
# console | kakao | sms
NOTIFY_PROVIDER=console

# 카카오 알림톡 (예: NHN Cloud / 카카오 비즈메시지 대행사)
KAKAO_ALIMTALK_API_URL=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_TEMPLATE_QUEUE_READY=

# SMS 폴백
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NUMBER=
